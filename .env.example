APP_ENV=development
API_PREFIX=/api

# MongoDB — also accepts MONGO_URI and DATABASE_NAME
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=rag_agent

# JWT — also accepts JWT_SECRET and ACCESS_TOKEN_EXPIRE_MINUTES
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=business-knowledge
PINECONE_INDEX_HOST=

# Embeddings — also accepts GEMINI_API_KEY
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=3072

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval — also accepts TOP_K
RETRIEVAL_TOP_K=5
MIN_SCORE=0.35

# HTTP
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=600000

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# WhatsApp Cloud API
# WHATSAPP_VERIFY_TOKEN is the string you enter in the Meta webhook console.
# WHATSAPP_APP_SECRET is the Facebook app secret used for X-Hub-Signature-256.
# WHATSAPP_ACCESS_TOKEN is the default Cloud API token when a business does not store its own.
# Per-business phone_number_id is stored in MongoDB after POST /api/whatsapp/connect.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_BASE_URL=
WHATSAPP_ENCRYPTION_KEY=
